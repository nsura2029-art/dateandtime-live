# Generated city pages — regenerated by scripts/build-us-cities-lite.js
# These are 15,994 static HTML files (~1.2GB) that can be rebuilt from
# the build script + data. Keeping them out of git keeps the repo small
# and lets us regenerate on demand.
world-time/united-states/*/index.html

# State landmark carousel images — generated by image_synthesize
world-time/state-images/
